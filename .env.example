# ==============================================================================
# Orbit — Single Life-OS for Students Environment Configuration
# ==============================================================================

# Supabase Public API (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Only Secret (Never expose to client or commit to version control)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection URLs (Prisma PostgreSQL)
# 1. Pooled Connection (port 6543 with pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (port 5432) for migrations and schema sync
DIRECT_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Google Gemini NLP Parser (Optional — falls back gracefully to deterministic parser)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
